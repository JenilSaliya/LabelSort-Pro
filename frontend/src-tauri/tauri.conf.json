{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LabelSort Pro",
  "version": "1.0.0",
  "identifier": "com.labelsort.pro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LabelSort Pro",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/**/*"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCNkMxMDI5QjFCQUUwQQpSV1FLcmh1YkFzRzJEKzhZZG9uNmRNUEI3d2FBdmxrV3YvTnZOaDByUXFndlUzZHFUWnBLUmpLbgo=",
      "endpoints": [
        "https://github.com/JenilSaliya/LabelSort-Pro/releases/latest/download/latest.json"
      ]
    }
  }
}
